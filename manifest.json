{
  "manifest_version": 3,
  "name": "Volume Booster",
  "version": "1.0.0",
  "description": "Boost the audio volume of the current browser tab up to 600%.",
  "minimum_chrome_version": "116",

  "permissions": ["tabCapture", "offscreen", "storage"],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "Volume Booster",
    "default_popup": "popup/popup.html"
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
